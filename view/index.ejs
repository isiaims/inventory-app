<!DOCTYPE html>
<html lang="en">
<%- include('partials/header', { title }) %>
<body>
    <header>
        <h3>Inventory</h3>
        <%- include('partials/nav') %>
    </header>
    <main>
        <% if (categories.length) { %>
            <% categories.forEach(function(category) { %>
                <div data-id="<%= category.id %>">
                    <h4><%= category.category.toUpperCase() %></h4>
                </div>
            <% }); %>
        <% } else { %>
            <h3>No categories yet.</h3>
        <% } %>    </main>
</body>
</html>